# Fundación Atenea · Hostinger (Apache/LiteSpeed)
Options -Indexes
RewriteEngine On

# Forzar HTTPS y dominio sin www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://ateneapiuraperu.org%{REQUEST_URI} [L,R=301]

# API
RewriteRule ^api/chat$ api/chat.php [L]
RewriteRule ^api/donar$ api/donar.php [L]
RewriteRule ^api/form$ api/form.php [L]

# URLs sin .html (/gracias -> gracias.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

ErrorDocument 404 /404.html

# Proteger archivos internos
<FilesMatch "^(config\.php|config\.example\.php|_lib\.php|conocimiento\.txt|README\.md|netlify\.toml|\.git.*)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(netlify|\.git)(/|$)

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
